---
import NewsArticlePage from "../../components/NewsArticlePage.astro";
import { getPublishedNewsPost } from "../../lib/news";

const { slug = "" } = Astro.params;
const { post, unavailable } = await getPublishedNewsPost(slug, "en");
Astro.response.status = unavailable ? 503 : post ? 200 : 404;
---

<NewsArticlePage lang="en" slug={slug} post={post} unavailable={unavailable} />
