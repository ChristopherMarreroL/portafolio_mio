---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/sections/Hero.astro";
import ProjectsSection from "../components/sections/ProjectsSection.astro";
import CoursesSection from "../components/sections/CoursesSection.astro";
import ContactSection from "../components/sections/ContactSection.astro";

type Lang = "es" | "en";

Astro.response.headers.set("Vary", "Accept-Language, Cookie");

const savedLanguage = Astro.cookies.get("lang")?.value;
const primaryLanguage = Astro.request.headers
  .get("accept-language")
  ?.split(",")[0]
  ?.trim()
  .toLowerCase();

const detectedLanguage: Lang = primaryLanguage?.startsWith("es") ? "es" : "en";
const lang: Lang = savedLanguage === "es" || savedLanguage === "en"
  ? savedLanguage
  : detectedLanguage;

const title = lang === "es" ? "Christopher | Portafolio" : "Christopher | Portfolio";
---

<BaseLayout title={title} lang={lang}>
  <Hero lang={lang} />
  <ProjectsSection lang={lang} />
  <CoursesSection lang={lang} />
  <ContactSection lang={lang} />
</BaseLayout>
