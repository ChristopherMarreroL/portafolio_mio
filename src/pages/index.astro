---
import PortfolioPage from "../components/PortfolioPage.astro";

type Lang = "es" | "en";

Astro.response.headers.set("Vary", "Accept-Language, Cookie");

const savedLanguage = Astro.cookies.get("lang")?.value;
const primaryLanguage = Astro.request.headers
  .get("accept-language")
  ?.split(",")[0]
  ?.trim()
  .toLowerCase();

const detectedLanguage: Lang = primaryLanguage?.startsWith("es") ? "es" : "en";
const lang: Lang = savedLanguage === "es" || savedLanguage === "en"
  ? savedLanguage
  : detectedLanguage;
---

<PortfolioPage lang={lang} />
