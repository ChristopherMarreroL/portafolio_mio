---
import AdminLayout from "../../../../layouts/AdminLayout.astro";

const { id } = Astro.params;
---

<AdminLayout title="Editar Proyecto">
  <div class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <h1 class="text-3xl font-semibold tracking-tight">Editar proyecto</h1>
      <p class="mt-2 text-slate-500 dark:text-slate-400">Actualiza contenido, imagen, URLs y estado publico.</p>
    </div>
    <a class="rounded-lg border border-slate-200 px-4 py-2 dark:border-slate-800" href="/admin/projects">Volver</a>
  </div>

  <form id="project-form" data-id={id} class="mt-6 grid gap-4 rounded-xl border border-slate-200 bg-white p-5 dark:border-slate-800 dark:bg-slate-950">
    <div class="grid gap-4 md:grid-cols-2">
      <label class="text-sm">Titulo ES<input id="title_es" required class="mt-1 w-full rounded-lg border border-slate-200 bg-white px-3 py-2 dark:border-slate-800 dark:bg-slate-950" /></label>
      <label class="text-sm">Titulo EN<input id="title_en" class="mt-1 w-full rounded-lg border border-slate-200 bg-white px-3 py-2 dark:border-slate-800 dark:bg-slate-950" /></label>
    </div>
    <label class="text-sm">Slug<input id="slug" required class="mt-1 w-full rounded-lg border border-slate-200 bg-white px-3 py-2 dark:border-slate-800 dark:bg-slate-950" /></label>
    <div class="grid gap-4 md:grid-cols-2">
      <label class="text-sm">Descripcion ES<textarea id="description_es" required rows="5" class="mt-1 w-full rounded-lg border border-slate-200 bg-white px-3 py-2 dark:border-slate-800 dark:bg-slate-950"></textarea></label>
      <label class="text-sm">Descripcion EN<textarea id="description_en" rows="5" class="mt-1 w-full rounded-lg border border-slate-200 bg-white px-3 py-2 dark:border-slate-800 dark:bg-slate-950"></textarea></label>
    </div>
    <label class="text-sm">Herramientas, separadas por coma<input id="tools" class="mt-1 w-full rounded-lg border border-slate-200 bg-white px-3 py-2 dark:border-slate-800 dark:bg-slate-950" /></label>
    <div class="grid gap-4 md:grid-cols-2">
      <label class="text-sm">URL del proyecto<input id="project_url" type="url" class="mt-1 w-full rounded-lg border border-slate-200 bg-white px-3 py-2 dark:border-slate-800 dark:bg-slate-950" /></label>
      <label class="text-sm">URL de GitHub<input id="github_url" type="url" class="mt-1 w-full rounded-lg border border-slate-200 bg-white px-3 py-2 dark:border-slate-800 dark:bg-slate-950" /></label>
    </div>
    <div class="grid gap-4 md:grid-cols-2">
      <div class="text-sm">
        <span>Nueva imagen</span>
        <div class="mt-1 flex flex-wrap items-center gap-3 rounded-lg border border-slate-200 bg-white px-3 py-2 dark:border-slate-800 dark:bg-slate-950">
          <label for="image_file" class="cursor-pointer rounded-lg bg-slate-900 px-3 py-2 text-sm font-medium text-white hover:opacity-90 dark:bg-white dark:text-slate-900">Elegir archivo</label>
          <span id="image_file_name" class="text-sm text-slate-500 dark:text-slate-400">Ningun archivo seleccionado</span>
          <button id="clear-image-file" type="button" class="rounded-lg border border-slate-200 px-3 py-2 text-xs dark:border-slate-700">Quitar selección</button>
          <input id="image_file" type="file" accept="image/*" class="sr-only" />
        </div>
      </div>
      <label class="text-sm">URL de imagen<input id="image_url" type="url" class="mt-1 w-full rounded-lg border border-slate-200 bg-white px-3 py-2 dark:border-slate-800 dark:bg-slate-950" /></label>
    </div>
    <div id="current-image" class="hidden w-fit rounded-xl border border-slate-200 p-3 dark:border-slate-800">
      <img id="image-preview" alt="Preview" class="max-h-64 rounded-lg object-contain" />
      <button id="delete-image" type="button" class="mt-3 w-full rounded-lg border border-red-200 px-3 py-2 text-sm text-red-600 dark:border-red-900 dark:text-red-400">Eliminar imagen</button>
    </div>
    <div class="grid gap-4 md:grid-cols-3">
      <label class="text-sm">Orden<input id="sort_order" type="number" class="mt-1 w-full rounded-lg border border-slate-200 bg-white px-3 py-2 dark:border-slate-800 dark:bg-slate-950" /></label>
      <label class="mt-7 flex items-center gap-2 text-sm"><input id="featured" type="checkbox" /> Destacado</label>
      <label class="mt-7 flex items-center gap-2 text-sm"><input id="published" type="checkbox" /> Publicado</label>
    </div>
    <div class="flex flex-wrap gap-3">
      <button class="rounded-lg bg-slate-900 px-4 py-2 text-white dark:bg-white dark:text-slate-900" type="submit">Guardar cambios</button>
      <a class="rounded-lg border border-slate-200 px-4 py-2 dark:border-slate-800" href="/admin/projects">Cancelar</a>
    </div>
    <p id="project-message" class="text-sm" role="status" aria-live="polite" aria-atomic="true">Cargando proyecto...</p>
  </form>

  <script>
    import { supabase } from "../../../../lib/supabase";
    import { bindFileName, checkedValue, clearFileInput, inputValue, listToInput, parseList, removeStoredImage, setChecked, setFormSubmitting, setValue, showMessage, uploadImage } from "../../../../lib/admin";
    import type { Project } from "../../../../types/content";

    const form = document.getElementById("project-form") as HTMLFormElement | null;
    const id = form?.dataset.id;
    let currentImageUrl: string | null = null;
    bindFileName("image_file", "image_file_name");
    document.getElementById("clear-image-file")?.addEventListener("click", () => clearFileInput("image_file", "image_file_name"));

    async function loadProject() {
      const { data, error } = await supabase.from("projects").select("*").eq("id", id).single();
      if (error) return showMessage("project-message", error.message, "error");
      const project = data as Project;
      currentImageUrl = project.image_url;
      setValue("title_es", project.title_es);
      setValue("title_en", project.title_en);
      setValue("slug", project.slug);
      setValue("description_es", project.description_es);
      setValue("description_en", project.description_en);
      setValue("tools", listToInput(project.tools));
      setValue("project_url", project.project_url);
      setValue("github_url", project.github_url);
      setValue("image_url", project.image_url);
      setValue("sort_order", project.sort_order);
      setChecked("featured", project.featured);
      setChecked("published", project.published);

      const preview = document.getElementById("image-preview") as HTMLImageElement | null;
      if (preview && project.image_url) {
        preview.src = project.image_url;
        document.getElementById("current-image")?.classList.remove("hidden");
      }
      showMessage("project-message", "Proyecto cargado.");
    }

    document.getElementById("delete-image")?.addEventListener("click", async () => {
      if (!currentImageUrl || !confirm("¿Quieres eliminar esta imagen? También se retirará del Storage si fue subida desde el panel.")) return;
      const previousUrl = currentImageUrl;
      const { error } = await supabase.from("projects").update({ image_url: null }).eq("id", id);
      if (error) return showMessage("project-message", error.message, "error");
      try {
        await removeStoredImage(previousUrl);
      } catch (storageError) {
        await supabase.from("projects").update({ image_url: previousUrl }).eq("id", id);
        return showMessage("project-message", storageError instanceof Error ? storageError.message : "No se pudo eliminar la imagen del Storage.", "error");
      }
      currentImageUrl = null;
      setValue("image_url", "");
      document.getElementById("current-image")?.classList.add("hidden");
      showMessage("project-message", "Imagen eliminada.", "success");
    });

    form?.addEventListener("submit", async (event) => {
      event.preventDefault();
      setFormSubmitting(form, true);
      showMessage("project-message", "Guardando...");
      let uploadedUrl: string | null = null;
      let saved = false;
      try {
        uploadedUrl = await uploadImage("image_file", "projects");
        const nextImageUrl = uploadedUrl || inputValue("image_url") || null;
        const { error } = await supabase.from("projects").update({
          title_es: inputValue("title_es"),
          title_en: inputValue("title_en") || null,
          slug: inputValue("slug"),
          description_es: inputValue("description_es"),
          description_en: inputValue("description_en") || null,
          tools: parseList(inputValue("tools")),
          image_url: nextImageUrl,
          project_url: inputValue("project_url") || null,
          github_url: inputValue("github_url") || null,
          featured: checkedValue("featured"),
          published: checkedValue("published"),
          sort_order: Number(inputValue("sort_order") || 0),
        }).eq("id", id);
        if (error) throw error;
        saved = true;
        if (currentImageUrl && currentImageUrl !== nextImageUrl) await removeStoredImage(currentImageUrl);
        showMessage("project-message", "Cambios guardados.", "success");
        location.href = "/admin/projects";
      } catch (error) {
        if (!saved && uploadedUrl) await removeStoredImage(uploadedUrl).catch(() => undefined);
        const prefix = saved ? "Los cambios se guardaron, pero no se pudo limpiar la imagen anterior: " : "";
        showMessage("project-message", prefix + (error instanceof Error ? error.message : "Error guardando cambios."), "error");
      } finally {
        setFormSubmitting(form, false);
      }
    });

    await loadProject();
  </script>
</AdminLayout>
