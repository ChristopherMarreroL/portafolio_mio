---
import AdminLayout from "../../../layouts/AdminLayout.astro";
---

<AdminLayout title="Admin Proyectos">
  <div class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <h1 class="text-3xl font-semibold tracking-tight">Proyectos</h1>
      <p class="mt-2 text-slate-500 dark:text-slate-400">Administra proyectos, enlaces, imagenes, herramientas y estado publico.</p>
    </div>
    <a class="rounded-lg bg-slate-900 px-4 py-2 text-white dark:bg-white dark:text-slate-900" href="/admin/projects/new">Nuevo proyecto</a>
  </div>

  <p id="projects-message" class="mt-6 text-sm text-slate-500 dark:text-slate-400" role="status" aria-live="polite" aria-atomic="true">Cargando proyectos...</p>
  <div id="projects-list" class="mt-6 overflow-x-auto rounded-xl border border-slate-200 dark:border-slate-800"></div>

  <script>
    import { supabase } from "../../../lib/supabase";
    import { removeStoredImages } from "../../../lib/admin";
    import type { Project } from "../../../types/content";

    const list = document.getElementById("projects-list");
    const message = document.getElementById("projects-message");

    function setMessage(text: string, error = false) {
      if (!message) return;
      message.textContent = text;
      message.setAttribute("role", error ? "alert" : "status");
      message.setAttribute("aria-live", error ? "assertive" : "polite");
      message.className = error ? "mt-6 text-sm text-red-500" : "mt-6 text-sm text-slate-500 dark:text-slate-400";
    }

    function createElement<K extends keyof HTMLElementTagNameMap>(tagName: K, className = "", text?: string) {
      const element = document.createElement(tagName);
      element.className = className;
      if (text !== undefined) element.textContent = text;
      return element;
    }

    async function loadProjects() {
      const { data, error } = await supabase.from("projects").select("*").order("sort_order", { ascending: true }).order("created_at", { ascending: false });
      if (error) {
        setMessage(error.message, true);
        return;
      }

      const projects = (data ?? []) as Project[];
      setMessage(`${projects.length} proyectos encontrados.`);
      if (!list) return;

      const table = createElement("table", "w-full min-w-[760px] text-left text-sm");
      const head = createElement("thead", "bg-slate-50 text-slate-500 dark:bg-slate-900 dark:text-slate-400");
      const headRow = createElement("tr");
      ["Titulo", "Orden", "Destacado", "Estado", "Acciones"].forEach((label) => {
        headRow.append(createElement("th", "px-4 py-3", label));
      });
      head.append(headRow);

      const body = createElement("tbody");
      projects.forEach((project) => {
        const row = createElement("tr", "border-t border-slate-200 dark:border-slate-800");
        const titleCell = createElement("td", "px-4 py-3");
        titleCell.append(
          createElement("strong", "", project.title_es),
          createElement("span", "block text-xs text-slate-500", project.slug),
        );

        const actionsCell = createElement("td", "px-4 py-3");
        const actions = createElement("div", "flex flex-wrap gap-2");
        const editLink = createElement("a", "rounded-lg border border-slate-200 px-3 py-1 dark:border-slate-800", "Editar");
        editLink.href = `/admin/projects/edit/${encodeURIComponent(project.id)}`;

        const toggleButton = createElement("button", "rounded-lg border border-slate-200 px-3 py-1 dark:border-slate-800", project.published ? "Despublicar" : "Publicar");
        toggleButton.type = "button";
        toggleButton.addEventListener("click", async () => {
          const { error } = await supabase.from("projects").update({ published: !project.published }).eq("id", project.id);
          if (error) return setMessage(error.message, true);
          await loadProjects();
        });

        const deleteButton = createElement("button", "rounded-lg border border-red-200 px-3 py-1 text-red-500 dark:border-red-900", "Eliminar");
        deleteButton.type = "button";
        deleteButton.addEventListener("click", async () => {
          if (!confirm("Seguro que quieres eliminar este proyecto?")) return;
          const { error } = await supabase.from("projects").delete().eq("id", project.id);
          if (error) return setMessage(error.message, true);
          try {
            await removeStoredImages([project.image_url]);
          } catch (storageError) {
            const { error: restoreError } = await supabase.from("projects").insert(project);
            const detail = storageError instanceof Error ? storageError.message : "No se pudo eliminar la imagen del Storage.";
            return setMessage(restoreError ? `${detail} Tampoco se pudo restaurar el proyecto: ${restoreError.message}` : `${detail} El proyecto fue restaurado para que puedas intentarlo otra vez.`, true);
          }
          await loadProjects();
        });

        actions.append(editLink, toggleButton, deleteButton);
        actionsCell.append(actions);
        row.append(
          titleCell,
          createElement("td", "px-4 py-3", String(project.sort_order)),
          createElement("td", "px-4 py-3", project.featured ? "Si" : "No"),
          createElement("td", "px-4 py-3", project.published ? "Publicado" : "Borrador"),
          actionsCell,
        );
        body.append(row);
      });

      table.append(head, body);
      list.replaceChildren(table);
    }

    await loadProjects();
  </script>
</AdminLayout>
