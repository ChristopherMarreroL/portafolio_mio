---
import AdminLayout from "../../../../layouts/AdminLayout.astro";

const { id } = Astro.params;
---

<AdminLayout title="Editar Formacion">
  <div class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <h1 class="text-3xl font-semibold tracking-tight">Editar formacion</h1>
      <p class="mt-2 text-slate-500 dark:text-slate-400">Actualiza tipo, preview, enlace oficial y estado publico.</p>
    </div>
    <a class="rounded-lg border border-slate-200 px-4 py-2 dark:border-slate-800" href="/admin/credentials">Volver</a>
  </div>

  <form id="credential-form" data-id={id} class="mt-6 grid gap-4 rounded-xl border border-slate-200 bg-white p-5 dark:border-slate-800 dark:bg-slate-950">
    <div class="grid gap-4 md:grid-cols-2">
      <label class="text-sm">Tipo<select id="type" required class="mt-1 w-full rounded-lg border border-slate-200 bg-white px-3 py-2 dark:border-slate-800 dark:bg-slate-950"><option value="degree">Degree</option><option value="course">Course</option><option value="diploma">Diploma</option><option value="certification">Certification</option><option value="recognition">Recognition</option></select></label>
      <label class="text-sm">Institucion / emisor<input id="issuer" required class="mt-1 w-full rounded-lg border border-slate-200 bg-white px-3 py-2 dark:border-slate-800 dark:bg-slate-950" /></label>
    </div>
    <div class="grid gap-4 md:grid-cols-2">
      <label class="text-sm">Titulo ES<input id="title_es" required class="mt-1 w-full rounded-lg border border-slate-200 bg-white px-3 py-2 dark:border-slate-800 dark:bg-slate-950" /></label>
      <label class="text-sm">Titulo EN<input id="title_en" class="mt-1 w-full rounded-lg border border-slate-200 bg-white px-3 py-2 dark:border-slate-800 dark:bg-slate-950" /></label>
    </div>
    <div class="grid gap-4 md:grid-cols-2">
      <label class="text-sm">Descripcion ES<textarea id="description_es" rows="4" class="mt-1 w-full rounded-lg border border-slate-200 bg-white px-3 py-2 dark:border-slate-800 dark:bg-slate-950"></textarea></label>
      <label class="text-sm">Descripcion EN<textarea id="description_en" rows="4" class="mt-1 w-full rounded-lg border border-slate-200 bg-white px-3 py-2 dark:border-slate-800 dark:bg-slate-950"></textarea></label>
    </div>
    <label class="text-sm">Etiquetas, separadas por coma<input id="tags" class="mt-1 w-full rounded-lg border border-slate-200 bg-white px-3 py-2 dark:border-slate-800 dark:bg-slate-950" /></label>
    <div class="grid gap-4 md:grid-cols-2">
      <div class="text-sm">
        <span>Nueva imagen o preview</span>
        <div class="mt-1 flex flex-wrap items-center gap-3 rounded-lg border border-slate-200 bg-white px-3 py-2 dark:border-slate-800 dark:bg-slate-950">
          <label for="image_file" class="cursor-pointer rounded-lg bg-slate-900 px-3 py-2 text-sm font-medium text-white hover:opacity-90 dark:bg-white dark:text-slate-900">Elegir archivo</label>
          <span id="image_file_name" class="text-sm text-slate-500 dark:text-slate-400">Ningun archivo seleccionado</span>
          <button id="clear-image-file" type="button" class="rounded-lg border border-slate-200 px-3 py-2 text-xs dark:border-slate-700">Quitar selección</button>
          <input id="image_file" type="file" accept="image/*" class="sr-only" />
        </div>
      </div>
      <label class="text-sm">URL de imagen<input id="image_url" type="url" class="mt-1 w-full rounded-lg border border-slate-200 bg-white px-3 py-2 dark:border-slate-800 dark:bg-slate-950" /></label>
    </div>
    <div id="current-image" class="hidden w-fit rounded-xl border border-slate-200 p-3 dark:border-slate-800">
      <img id="image-preview" alt="Preview" class="max-h-64 rounded-lg object-contain" />
      <button id="delete-image" type="button" class="mt-3 w-full rounded-lg border border-red-200 px-3 py-2 text-sm text-red-600 dark:border-red-900 dark:text-red-400">Eliminar imagen</button>
    </div>
    <div class="grid gap-4 md:grid-cols-3">
      <label class="text-sm">Enlace oficial<input id="credential_url" type="url" class="mt-1 w-full rounded-lg border border-slate-200 bg-white px-3 py-2 dark:border-slate-800 dark:bg-slate-950" /></label>
      <label class="text-sm">Fecha de emision<input id="issued_date" type="date" class="mt-1 w-full rounded-lg border border-slate-200 bg-white px-3 py-2 [color-scheme:light] dark:border-slate-800 dark:bg-slate-950 dark:[color-scheme:dark]" /></label>
      <label class="text-sm">Orden<input id="sort_order" type="number" class="mt-1 w-full rounded-lg border border-slate-200 bg-white px-3 py-2 dark:border-slate-800 dark:bg-slate-950" /></label>
    </div>
    <label class="flex items-center gap-2 text-sm"><input id="published" type="checkbox" /> Publicado</label>
    <div class="flex flex-wrap gap-3"><button class="rounded-lg bg-slate-900 px-4 py-2 text-white dark:bg-white dark:text-slate-900" type="submit">Guardar cambios</button><a class="rounded-lg border border-slate-200 px-4 py-2 dark:border-slate-800" href="/admin/credentials">Cancelar</a></div>
    <p id="credential-message" class="text-sm" role="status" aria-live="polite" aria-atomic="true">Cargando formacion...</p>
  </form>

  <script>
    import { supabase } from "../../../../lib/supabase";
    import { bindFileName, checkedValue, clearFileInput, inputValue, listToInput, parseList, removeStoredImage, setChecked, setFormSubmitting, setValue, showMessage, uploadImage } from "../../../../lib/admin";
    import type { Credential } from "../../../../types/content";

    const form = document.getElementById("credential-form") as HTMLFormElement | null;
    const id = form?.dataset.id;
    let currentImageUrl: string | null = null;
    bindFileName("image_file", "image_file_name");
    document.getElementById("clear-image-file")?.addEventListener("click", () => clearFileInput("image_file", "image_file_name"));

    async function loadCredential() {
      const { data, error } = await supabase.from("credentials").select("*").eq("id", id).single();
      if (error) return showMessage("credential-message", error.message, "error");
      const item = data as Credential;
      currentImageUrl = item.image_url;
      setValue("type", item.type);
      setValue("issuer", item.issuer);
      setValue("title_es", item.title_es);
      setValue("title_en", item.title_en);
      setValue("description_es", item.description_es);
      setValue("description_en", item.description_en);
      setValue("tags", listToInput(item.tags));
      setValue("image_url", item.image_url);
      setValue("credential_url", item.credential_url);
      setValue("issued_date", item.issued_date);
      setValue("sort_order", item.sort_order);
      setChecked("published", item.published);

      const preview = document.getElementById("image-preview") as HTMLImageElement | null;
      if (preview && item.image_url) {
        preview.src = item.image_url;
        document.getElementById("current-image")?.classList.remove("hidden");
      }
      showMessage("credential-message", "Formacion cargada.");
    }

    document.getElementById("delete-image")?.addEventListener("click", async () => {
      if (!currentImageUrl || !confirm("¿Quieres eliminar esta imagen? También se retirará del Storage si fue subida desde el panel.")) return;
      const previousUrl = currentImageUrl;
      const { error } = await supabase.from("credentials").update({ image_url: null }).eq("id", id);
      if (error) return showMessage("credential-message", error.message, "error");
      try {
        await removeStoredImage(previousUrl);
      } catch (storageError) {
        await supabase.from("credentials").update({ image_url: previousUrl }).eq("id", id);
        return showMessage("credential-message", storageError instanceof Error ? storageError.message : "No se pudo eliminar la imagen del Storage.", "error");
      }
      currentImageUrl = null;
      setValue("image_url", "");
      document.getElementById("current-image")?.classList.add("hidden");
      showMessage("credential-message", "Imagen eliminada.", "success");
    });

    form?.addEventListener("submit", async (event) => {
      event.preventDefault();
      setFormSubmitting(form, true);
      showMessage("credential-message", "Guardando...");
      let uploadedUrl: string | null = null;
      let saved = false;
      try {
        uploadedUrl = await uploadImage("image_file", "credentials");
        const nextImageUrl = uploadedUrl || inputValue("image_url") || null;
        const { error } = await supabase.from("credentials").update({
          type: inputValue("type"),
          title_es: inputValue("title_es"),
          title_en: inputValue("title_en") || null,
          issuer: inputValue("issuer"),
          issued_date: inputValue("issued_date") || null,
          description_es: inputValue("description_es") || null,
          description_en: inputValue("description_en") || null,
          tags: parseList(inputValue("tags")),
          image_url: nextImageUrl,
          credential_url: inputValue("credential_url") || null,
          published: checkedValue("published"),
          sort_order: Number(inputValue("sort_order") || 0),
        }).eq("id", id);
        if (error) throw error;
        saved = true;
        if (currentImageUrl && currentImageUrl !== nextImageUrl) await removeStoredImage(currentImageUrl);
        showMessage("credential-message", "Cambios guardados.", "success");
        location.href = "/admin/credentials";
      } catch (error) {
        if (!saved && uploadedUrl) await removeStoredImage(uploadedUrl).catch(() => undefined);
        const prefix = saved ? "Los cambios se guardaron, pero no se pudo limpiar la imagen anterior: " : "";
        showMessage("credential-message", prefix + (error instanceof Error ? error.message : "Error guardando cambios."), "error");
      } finally {
        setFormSubmitting(form, false);
      }
    });

    await loadCredential();
  </script>
</AdminLayout>
