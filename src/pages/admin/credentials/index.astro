---
import AdminLayout from "../../../layouts/AdminLayout.astro";
---

<AdminLayout title="Admin Formacion">
  <div class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <h1 class="text-3xl font-semibold tracking-tight">Formacion</h1>
      <p class="mt-2 text-slate-500 dark:text-slate-400">Cursos, certificaciones, diplomas, reconocimientos y estudios.</p>
    </div>
    <a class="rounded-lg bg-slate-900 px-4 py-2 text-white dark:bg-white dark:text-slate-900" href="/admin/credentials/new">Nueva formacion</a>
  </div>

  <div class="mt-6 flex flex-wrap gap-2">
    <button class="filter rounded-lg border border-slate-200 px-3 py-2 text-sm dark:border-slate-800" data-type="">Todas</button>
    <button class="filter rounded-lg border border-slate-200 px-3 py-2 text-sm dark:border-slate-800" data-type="degree">Degree</button>
    <button class="filter rounded-lg border border-slate-200 px-3 py-2 text-sm dark:border-slate-800" data-type="course">Course</button>
    <button class="filter rounded-lg border border-slate-200 px-3 py-2 text-sm dark:border-slate-800" data-type="diploma">Diploma</button>
    <button class="filter rounded-lg border border-slate-200 px-3 py-2 text-sm dark:border-slate-800" data-type="certification">Certification</button>
    <button class="filter rounded-lg border border-slate-200 px-3 py-2 text-sm dark:border-slate-800" data-type="recognition">Recognition</button>
  </div>

  <p id="credentials-message" class="mt-6 text-sm text-slate-500 dark:text-slate-400" role="status" aria-live="polite" aria-atomic="true">Cargando formacion...</p>
  <div id="credentials-list" class="mt-6 overflow-x-auto rounded-xl border border-slate-200 dark:border-slate-800"></div>

  <script>
    import { supabase } from "../../../lib/supabase";
    import type { Credential } from "../../../types/content";

    const list = document.getElementById("credentials-list");
    const message = document.getElementById("credentials-message");
    let activeType = "";

    function setMessage(text: string, error = false) {
      if (!message) return;
      message.textContent = text;
      message.setAttribute("role", error ? "alert" : "status");
      message.setAttribute("aria-live", error ? "assertive" : "polite");
      message.className = error ? "mt-6 text-sm text-red-500" : "mt-6 text-sm text-slate-500 dark:text-slate-400";
    }

    function createElement<K extends keyof HTMLElementTagNameMap>(tagName: K, className = "", text?: string) {
      const element = document.createElement(tagName);
      element.className = className;
      if (text !== undefined) element.textContent = text;
      return element;
    }

    async function loadCredentials() {
      let query = supabase.from("credentials").select("*").order("sort_order", { ascending: true }).order("issued_date", { ascending: false });
      if (activeType) query = query.eq("type", activeType);
      const { data, error } = await query;
      if (error) return setMessage(error.message, true);

      const credentials = (data ?? []) as Credential[];
      setMessage(`${credentials.length} elementos encontrados.`);
      if (!list) return;
      const table = createElement("table", "w-full min-w-[760px] text-left text-sm");
      const head = createElement("thead", "bg-slate-50 text-slate-500 dark:bg-slate-900 dark:text-slate-400");
      const headRow = createElement("tr");
      ["Titulo", "Tipo", "Fecha", "Estado", "Acciones"].forEach((label) => {
        headRow.append(createElement("th", "px-4 py-3", label));
      });
      head.append(headRow);

      const body = createElement("tbody");
      credentials.forEach((item) => {
        const row = createElement("tr", "border-t border-slate-200 dark:border-slate-800");
        const titleCell = createElement("td", "px-4 py-3");
        titleCell.append(
          createElement("strong", "", item.title_es),
          createElement("span", "block text-xs text-slate-500", item.issuer),
        );

        const actionsCell = createElement("td", "px-4 py-3");
        const actions = createElement("div", "flex flex-wrap gap-2");
        const editLink = createElement("a", "rounded-lg border border-slate-200 px-3 py-1 dark:border-slate-800", "Editar");
        editLink.href = `/admin/credentials/edit/${encodeURIComponent(item.id)}`;

        const toggleButton = createElement("button", "rounded-lg border border-slate-200 px-3 py-1 dark:border-slate-800", item.published ? "Despublicar" : "Publicar");
        toggleButton.type = "button";
        toggleButton.addEventListener("click", async () => {
          const { error } = await supabase.from("credentials").update({ published: !item.published }).eq("id", item.id);
          if (error) return setMessage(error.message, true);
          await loadCredentials();
        });

        const deleteButton = createElement("button", "rounded-lg border border-red-200 px-3 py-1 text-red-500 dark:border-red-900", "Eliminar");
        deleteButton.type = "button";
        deleteButton.addEventListener("click", async () => {
          if (!confirm("Seguro que quieres eliminar este elemento de formacion?")) return;
          const { error } = await supabase.from("credentials").delete().eq("id", item.id);
          if (error) return setMessage(error.message, true);
          await loadCredentials();
        });

        actions.append(editLink, toggleButton, deleteButton);
        actionsCell.append(actions);
        row.append(
          titleCell,
          createElement("td", "px-4 py-3", item.type),
          createElement("td", "px-4 py-3", item.issued_date ?? ""),
          createElement("td", "px-4 py-3", item.published ? "Publicado" : "Borrador"),
          actionsCell,
        );
        body.append(row);
      });

      table.append(head, body);
      list.replaceChildren(table);
    }

    document.querySelectorAll<HTMLButtonElement>(".filter").forEach((button) => button.addEventListener("click", async () => {
      activeType = button.dataset.type ?? "";
      await loadCredentials();
    }));

    await loadCredentials();
  </script>
</AdminLayout>
