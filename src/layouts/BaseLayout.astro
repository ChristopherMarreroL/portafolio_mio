---
import "../styles/global.css";
import Navbar from "../components/layout/Navbar.astro";
import Footer from "../components/layout/Footer.astro";
import Analytics from "@vercel/analytics/astro";
import SpeedInsights from "@vercel/speed-insights/astro";

interface Props {
  title?: string;
  description?: string;
  lang?: "es" | "en";
  image?: string;
  imageAlt?: string;
  imageType?: string;
  imageWidth?: number;
  imageHeight?: number;
  pageType?: "website" | "article";
  publishedTime?: string;
  alternatePath?: string;
  alternateLang?: "es" | "en";
  structuredData?: Record<string, unknown>;
}

const {
  title = "Christopher | Full Stack Software Developer",
  description = "Full Stack Software Developer focused on building scalable web and mobile applications with strong user experiences.",
  lang = "en",
  image = "/og-image.png",
  imageAlt,
  imageType,
  imageWidth,
  imageHeight,
  pageType = "website",
  publishedTime,
  alternatePath,
  alternateLang,
  structuredData: pageStructuredData,
} = Astro.props as Props;

const canonical = Astro.site
  ? new URL(Astro.url.pathname, Astro.site).toString()
  : Astro.url.toString();
const socialImage = new URL(image, Astro.site ?? Astro.url).toString();
const usesDefaultSocialImage = image === "/og-image.png";
const socialImageType = imageType ?? (usesDefaultSocialImage ? "image/png" : undefined);
const socialImageWidth = imageWidth ?? (usesDefaultSocialImage ? 1200 : undefined);
const socialImageHeight = imageHeight ?? (usesDefaultSocialImage ? 630 : undefined);
const locale = lang === "es" ? "es_ES" : "en_US";
const alternateLocale = lang === "es" ? "en_US" : "es_ES";
const socialImageAlt = imageAlt ?? (lang === "es"
  ? "Logo de Christopher, desarrollador de software Full Stack"
  : "Christopher's logo, Full Stack Software Developer");

const structuredData = pageStructuredData ?? {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Christopher",
  url: canonical,
  image: socialImage,
  jobTitle: lang === "es" ? "Desarrollador de Software Full Stack" : "Full Stack Software Developer",
  sameAs: [
    "https://github.com/ChristopherMarreroL",
    "https://www.linkedin.com/in/christopher-e-marrero-l-9168a326b/",
  ],
};
const serializedStructuredData = JSON.stringify(structuredData)
  .replace(/</g, "\\u003c")
  .replace(/>/g, "\\u003e")
  .replace(/&/g, "\\u0026")
  .replace(/\u2028/g, "\\u2028")
  .replace(/\u2029/g, "\\u2029");
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Christopher" />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="theme-color" content="#020617" />

    <meta property="og:type" content={pageType} />
    <meta property="og:site_name" content="Christopher | Portfolio" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:secure_url" content={socialImage} />
    {socialImageType && <meta property="og:image:type" content={socialImageType} />}
    {socialImageWidth && <meta property="og:image:width" content={String(socialImageWidth)} />}
    {socialImageHeight && <meta property="og:image:height" content={String(socialImageHeight)} />}
    <meta property="og:image:alt" content={socialImageAlt} />
    <meta property="og:locale" content={locale} />
    <meta property="og:locale:alternate" content={alternateLocale} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={socialImageAlt} />

    <link rel="icon" type="image/webp" href="/logo.webp" />
    <link rel="apple-touch-icon" href="/logo.png" />
    <link rel="canonical" href={canonical} />
    {alternatePath && alternateLang && (
      <link rel="alternate" hreflang={alternateLang} href={new URL(alternatePath, Astro.site ?? Astro.url).toString()} />
    )}
    <link rel="alternate" hreflang={lang} href={canonical} />
    <script type="application/ld+json" set:html={serializedStructuredData} />

    <script is:inline>
      (function () {
        const storageKey = "theme";
        const root = document.documentElement;

        const saved = localStorage.getItem(storageKey);
        const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
        const theme = saved ? saved : (prefersDark ? "dark" : "light");

        if (theme === "dark") root.classList.add("dark");
        else root.classList.remove("dark");

        root.style.colorScheme = theme;
      })();
    </script>
  </head>

  <body
    class="min-h-screen bg-white text-slate-900 antialiased
           dark:bg-slate-950 dark:text-slate-100"
  >
    <Navbar lang={lang} />

    <main class="mx-auto w-full max-w-5xl px-6 py-10">
      <slot />
    </main>

    <Footer lang={lang} />

    <Analytics />
    <SpeedInsights />

    <script is:inline>
      const storageKey = "theme";
      const root = document.documentElement;

      function applyTheme(theme) {
        if (theme === "dark") root.classList.add("dark");
        else root.classList.remove("dark");

        root.style.colorScheme = theme;
      }

      window.toggleTheme = () => {
        const isDark = root.classList.contains("dark");
        const next = isDark ? "light" : "dark";
        applyTheme(next);
        localStorage.setItem(storageKey, next);
      };
    </script>
  </body>
</html>
