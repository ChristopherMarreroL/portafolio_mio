---
import Modal from "./ui/Modal.astro";
import { isEmbeddablePdfUrl, isPdfUrl } from "../lib/media";

type Lang = "es" | "en";
type I18nText = { es: string; en: string };

type Course = {
  type?: I18nText;
  title: I18nText;
  provider: I18nText;
  date?: string;
  skills?: string[];
  image?: string;
  link?: string;
};

const { course, lang = "en" } = Astro.props as { course: Course; lang?: Lang };

const typeText = course.type?.[lang] ?? course.type?.en ?? "";
const titleText = course.title?.[lang] ?? course.title.en;
const providerText = course.provider?.[lang] ?? course.provider.en;

const modalId = `cert-${course.title.en.replace(/[^a-z0-9]+/gi, "-").toLowerCase()}`;
const previewIsPdf = isPdfUrl(course.image);
const previewCanEmbedPdf = isEmbeddablePdfUrl(course.image);
---

<article
  class="transform-gpu rounded-xl border border-slate-200 bg-white p-5
         shadow-[0_12px_36px_rgba(15,23,42,0.06)]
         transition-[transform,box-shadow,border-color,background-color] duration-500
         ease-[cubic-bezier(0.22,1,0.36,1)] will-change-transform
         hover:-translate-y-1.5 hover:scale-[1.02] hover:border-slate-300
         hover:shadow-[0_24px_70px_rgba(15,23,42,0.14)]
         motion-reduce:transform-none motion-reduce:transition-none
         dark:border-slate-800 dark:bg-slate-950 dark:shadow-black/20 dark:hover:shadow-[0_24px_70px_rgba(0,0,0,0.34)]"
>
  {typeText && (
    <p class="text-xs text-slate-500 dark:text-slate-400">
      {typeText}
    </p>
  )}

  <h3 class="mt-1 font-semibold tracking-tight">
    {titleText}
  </h3>

  <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">
    {providerText}{course.date ? ` - ${course.date}` : ""}
  </p>

  <div class="mt-3 flex flex-wrap gap-2">
    {course.skills?.map((s: string) => (
      <span
        class="rounded-full bg-slate-100 px-2 py-1 text-xs text-slate-700
               transition-all duration-200 ease-out
               hover:-translate-y-0.5 hover:bg-slate-200
               dark:bg-slate-900 dark:text-slate-200 dark:border dark:border-slate-800
               dark:hover:bg-slate-800"
      >
        {s}
      </span>
    ))}
  </div>

  <div class="mt-4 flex flex-wrap gap-2">
    {course.link && (
      <a
        href={course.link}
        target="_blank"
        rel="noreferrer"
        title={lang === "es" ? "Ver certificado" : "Open certificate"}
        aria-label={lang === "es" ? "Ver certificado" : "Open certificate"}
        class="inline-flex h-10 w-10 items-center justify-center rounded-lg
               border border-slate-200 bg-white text-slate-700
               transition-all duration-200 ease-out
               hover:scale-105 hover:bg-slate-50 active:scale-95
               dark:border-slate-800 dark:bg-slate-950 dark:text-slate-200
               dark:hover:bg-slate-900"
      >
        &#128279;
      </a>
    )}

    {course.image && (
      <>
        <button
          type="button"
          title={lang === "es" ? "Vista previa" : "Preview"}
          aria-label={lang === "es" ? "Vista previa del certificado" : "Certificate preview"}
          class="inline-flex h-10 w-10 items-center justify-center rounded-lg
                 border border-slate-200 bg-white text-slate-700
                 transition-all duration-200 ease-out
                 hover:scale-105 hover:bg-slate-50 active:scale-95
                 dark:border-slate-800 dark:bg-slate-950 dark:text-slate-200
                 dark:hover:bg-slate-900"
          onclick={`document.getElementById('${modalId}')?.showModal()`}
        >
          &#128065;
        </button>

        <Modal
          id={modalId}
          title={titleText}
          closeLabel={lang === "es" ? "Cerrar dialogo" : "Close dialog"}
        >
          <div class="space-y-4">
            <p class="text-sm text-slate-500 dark:text-slate-400">
              {providerText}{course.date ? ` - ${course.date}` : ""}
            </p>

            {previewIsPdf ? (
              <>
                {previewCanEmbedPdf ? (
                  <iframe
                    src={`${course.image}#view=FitH`}
                    title={`${lang === "es" ? "Documento PDF" : "PDF document"}: ${titleText}`}
                    class="h-[70vh] w-full rounded-lg border border-slate-200 bg-slate-100 dark:border-slate-800 dark:bg-slate-900"
                    loading="lazy"
                  ></iframe>
                ) : (
                  <div class="flex min-h-72 flex-col items-center justify-center rounded-lg border border-slate-200 bg-slate-50 dark:border-slate-800 dark:bg-slate-900"><span class="text-6xl font-black tracking-[-0.08em] text-red-600">PDF</span><p class="mt-3 text-sm text-slate-500 dark:text-slate-400">{lang === "es" ? "Este documento externo se abre en una pestaña segura." : "This external document opens in a separate tab."}</p></div>
                )}
                <a href={course.image} target="_blank" rel="noopener noreferrer" class="inline-flex rounded-full bg-slate-950 px-4 py-2 text-sm font-semibold text-white dark:bg-white dark:text-slate-950">
                  {lang === "es" ? "Abrir PDF completo ↗" : "Open full PDF ↗"}
                </a>
              </>
            ) : (
              <img
                src={course.image}
                alt={`${lang === "es" ? "Certificado" : "Certificate"}: ${titleText}`}
                class="mx-auto w-full max-w-2xl rounded-lg border border-slate-200 object-contain dark:border-slate-800"
                loading="lazy"
                style="max-height: 80vh;"
              />
            )}
          </div>
        </Modal>
      </>
    )}
  </div>
</article>
