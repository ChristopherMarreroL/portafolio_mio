---
import type { Lang } from "../../types/content";

const { images, title, appName, lang } = Astro.props as {
  images: string[];
  title: string;
  appName: string;
  lang: Lang;
};

const imageAlt = (index: number) => index === 0
  ? title
  : `${appName} — ${lang === "es" ? "imagen" : "image"} ${index + 1}`;
---

{images.length > 0 && (
  <div data-article-gallery class="mt-10">
    <div class="grid gap-3 sm:grid-cols-2">
      {images.map((url, index) => (
        <button
          type="button"
          data-article-image
          data-src={url}
          data-alt={imageAlt(index)}
          aria-label={`${lang === "es" ? "Ampliar imagen" : "Expand image"} ${index + 1}`}
          class="group relative flex aspect-[16/10] w-full items-center justify-center overflow-hidden rounded-2xl border border-slate-200 bg-slate-50 p-3 transition-colors hover:border-sky-400 focus:outline-none focus-visible:ring-2 focus-visible:ring-sky-500 dark:border-slate-800 dark:bg-slate-900 dark:hover:border-sky-500"
        >
          <img src={url} alt={imageAlt(index)} loading={index === 0 ? "eager" : "lazy"} class="h-full w-full object-contain" />
          <span aria-hidden="true" class="absolute bottom-3 right-3 rounded-full bg-slate-950/85 px-3 py-1.5 text-xs font-semibold text-white shadow-sm transition-colors group-hover:bg-sky-700">
            {lang === "es" ? "Ampliar ↗" : "Expand ↗"}
          </span>
        </button>
      ))}
    </div>

    <dialog
      data-image-dialog
      aria-label={lang === "es" ? "Visor de imágenes del artículo" : "Article image viewer"}
      class="fixed inset-0 m-0 h-dvh max-h-none w-screen max-w-none border-0 bg-slate-950 p-3 text-white backdrop:bg-slate-950 sm:p-6"
    >
      <div class="flex h-full min-h-0 flex-col gap-3">
        <div class="flex items-center justify-between gap-3">
          <p class="min-w-0 truncate text-sm font-medium">{title}</p>
          <div class="flex shrink-0 items-center gap-2">
            <button type="button" data-zoom-out aria-label={lang === "es" ? "Reducir imagen" : "Zoom out"} class="flex size-10 items-center justify-center rounded-full border border-white/30 text-xl hover:bg-white/15 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white">−</button>
            <button type="button" data-zoom-in aria-label={lang === "es" ? "Ampliar imagen" : "Zoom in"} class="flex size-10 items-center justify-center rounded-full border border-white/30 text-xl hover:bg-white/15 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white">+</button>
            <button type="button" data-close-image aria-label={lang === "es" ? "Cerrar imagen" : "Close image"} class="flex size-10 items-center justify-center rounded-full border border-white/30 text-xl hover:bg-white/15 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white">×</button>
          </div>
        </div>
        <div data-image-stage class="flex min-h-0 flex-1 items-center justify-center overflow-auto rounded-xl bg-slate-900 p-2">
          <img data-lightbox-image src={images[0]} alt={imageAlt(0)} draggable="false" class="mx-auto block h-auto max-h-full max-w-full select-none object-contain" />
        </div>
        <p class="text-center text-xs text-slate-300">{lang === "es" ? "Esc para cerrar · + y − para zoom · Arrastra la imagen ampliada para moverla" : "Esc to close · + and − to zoom · Drag the enlarged image to move it"}</p>
      </div>
    </dialog>
  </div>
)}

<script>
  for (const gallery of document.querySelectorAll<HTMLElement>("[data-article-gallery]")) {
    const dialog = gallery.querySelector<HTMLDialogElement>("[data-image-dialog]");
    const stage = gallery.querySelector<HTMLElement>("[data-image-stage]");
    const fullImage = gallery.querySelector<HTMLImageElement>("[data-lightbox-image]");
    const zoomIn = gallery.querySelector<HTMLButtonElement>("[data-zoom-in]");
    const zoomOut = gallery.querySelector<HTMLButtonElement>("[data-zoom-out]");
    const close = gallery.querySelector<HTMLButtonElement>("[data-close-image]");
    if (!dialog || !stage || !fullImage || !zoomIn || !zoomOut || !close) continue;

    const maxZoomSteps = 20;
    let zoomStep = 0;
    let fittedWidth = 0;
    let imageReady = false;
    let drag: { pointerId: number; x: number; y: number; left: number; top: number } | null = null;
    const setZoomStep = (value: number) => {
      if (value > 0 && !imageReady) return;
      zoomStep = Math.max(0, Math.min(maxZoomSteps, value));
      const fitted = zoomStep === 0;
      stage.classList.toggle("flex", fitted);
      stage.classList.toggle("items-center", fitted);
      stage.classList.toggle("justify-center", fitted);
      if (!fitted && !fittedWidth) fittedWidth = fullImage.getBoundingClientRect().width || stage.clientWidth;
      fullImage.style.width = fitted ? "" : `${fittedWidth * (1 + zoomStep * 0.1)}px`;
      fullImage.style.maxWidth = fitted ? "" : "none";
      fullImage.style.maxHeight = fitted ? "" : "none";
      fullImage.classList.toggle("cursor-grab", !fitted);
      if (fitted) fittedWidth = fullImage.getBoundingClientRect().width;
      zoomOut.disabled = fitted;
      zoomIn.disabled = !imageReady || zoomStep === maxZoomSteps;
    };

    fullImage.addEventListener("load", () => {
      imageReady = fullImage.naturalWidth > 0;
      if (dialog.open && zoomStep === 0) setZoomStep(0);
    });
    fullImage.addEventListener("error", () => {
      imageReady = false;
      zoomIn.disabled = true;
    });

    for (const trigger of gallery.querySelectorAll<HTMLButtonElement>("[data-article-image]")) {
      trigger.addEventListener("click", () => {
        imageReady = false;
        fittedWidth = 0;
        fullImage.src = trigger.dataset.src || "";
        fullImage.alt = trigger.dataset.alt || "";
        dialog.showModal();
        imageReady = fullImage.complete && fullImage.naturalWidth > 0 && fullImage.currentSrc === fullImage.src;
        setZoomStep(0);
        close.focus();
      });
    }

    zoomIn.addEventListener("click", () => setZoomStep(zoomStep + 1));
    zoomOut.addEventListener("click", () => setZoomStep(zoomStep - 1));
    fullImage.addEventListener("pointerdown", (event) => {
      if (zoomStep === 0 || event.pointerType !== "mouse" || event.button !== 0) return;
      drag = {
        pointerId: event.pointerId,
        x: event.clientX,
        y: event.clientY,
        left: stage.scrollLeft,
        top: stage.scrollTop,
      };
      fullImage.setPointerCapture(event.pointerId);
      fullImage.classList.remove("cursor-grab");
      fullImage.classList.add("cursor-grabbing");
      event.preventDefault();
    });
    fullImage.addEventListener("pointermove", (event) => {
      if (!drag || event.pointerId !== drag.pointerId) return;
      stage.scrollLeft = drag.left - (event.clientX - drag.x);
      stage.scrollTop = drag.top - (event.clientY - drag.y);
    });
    const stopDrag = (event: PointerEvent) => {
      if (!drag || event.pointerId !== drag.pointerId) return;
      drag = null;
      fullImage.classList.remove("cursor-grabbing");
      if (zoomStep > 0) fullImage.classList.add("cursor-grab");
      if (fullImage.hasPointerCapture(event.pointerId)) fullImage.releasePointerCapture(event.pointerId);
    };
    fullImage.addEventListener("pointerup", stopDrag);
    fullImage.addEventListener("pointercancel", stopDrag);
    fullImage.addEventListener("lostpointercapture", stopDrag);
    close.addEventListener("click", () => dialog.close());
    dialog.addEventListener("close", () => {
      drag = null;
      fullImage.classList.remove("cursor-grabbing");
    });
    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) dialog.close();
    });
    stage.addEventListener("click", (event) => {
      if (event.target === stage) dialog.close();
    });
    dialog.addEventListener("keydown", (event) => {
      if (event.key === "+" || event.key === "=") setZoomStep(zoomStep + 1);
      if (event.key === "-") setZoomStep(zoomStep - 1);
    });
  }
</script>
