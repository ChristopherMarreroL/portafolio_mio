---
import BaseLayout from "../layouts/BaseLayout.astro";
import { safeHttpUrl } from "../lib/urls";
import type { Lang, NewsPost } from "../types/content";

const { lang, slug, post, unavailable = false } = Astro.props as {
  lang: Lang;
  slug: string;
  post: NewsPost | null;
  unavailable?: boolean;
};
const title = post
  ? (lang === "es" ? post.title_es : post.title_en || post.title_es)
  : unavailable
    ? (lang === "es" ? "Artículos no disponibles temporalmente" : "Articles temporarily unavailable")
    : (lang === "es" ? "Artículo no encontrado" : "Article not found");
const excerpt = post ? (lang === "es" ? post.excerpt_es : post.excerpt_en || post.excerpt_es) : "";
const content = post ? (lang === "es" ? post.content_es : post.content_en || post.content_es) : "";
const images = post
  ? (post.image_urls?.length ? post.image_urls : [post.image_url]).map(safeHttpUrl).filter((url): url is string => Boolean(url)).slice(0, 3)
  : [];
const image = images[0];
const appUrl = post ? safeHttpUrl(post.app_url) : undefined;
const archivePath = lang === "es" ? "/articulos" : "/articles";
const hasEnglishVersion = Boolean(post?.title_en && post?.excerpt_en && post?.content_en);
const alternatePath = post && (lang === "en" || hasEnglishVersion)
  ? `${lang === "es" ? "/articles" : "/articulos"}/${encodeURIComponent(slug)}`
  : undefined;
const date = post?.published_at || post?.created_at;
const formattedDate = date ? new Intl.DateTimeFormat(lang === "es" ? "es-VE" : "en-US", { dateStyle: "long" }).format(new Date(date)) : "";
const articleSchema = post ? {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: title,
  description: excerpt,
  image: images.length > 0 ? images : undefined,
  datePublished: date,
  dateModified: post.updated_at,
  inLanguage: lang,
  author: { "@type": "Person", name: "Christopher" },
  about: post.app_name,
  keywords: post.tags?.join(", "),
} : undefined;
---

<BaseLayout
  title={`${title} | Christopher`}
  description={excerpt || title}
  lang={lang}
  image={image}
  imageAlt={title}
  pageType="article"
  publishedTime={date}
  alternatePath={alternatePath}
  alternateLang={alternatePath ? (lang === "es" ? "en" : "es") : undefined}
  structuredData={articleSchema}
>
  {!post ? (
    <section class="py-20 text-center">
      <p class="font-mono text-xs uppercase tracking-[0.2em] text-sky-700 dark:text-sky-300">{unavailable ? "503" : "404"}</p>
      <h1 class="mt-3 text-3xl font-semibold">{title}</h1>
      <a class="mt-6 inline-block text-sm font-semibold text-sky-700 dark:text-sky-300" href={archivePath}>← {lang === "es" ? "Ver artículos" : "View articles"}</a>
    </section>
  ) : (
    <article class="mx-auto max-w-3xl py-6 sm:py-12">
      <a class="text-sm text-slate-500 hover:text-sky-700 dark:text-slate-400 dark:hover:text-sky-300" href={archivePath}>← {lang === "es" ? "Todos los artículos" : "All articles"}</a>
      <header class="mt-10">
        <div class="flex flex-wrap items-center gap-3 font-mono text-xs uppercase tracking-[0.18em] text-slate-500 dark:text-slate-400">
          <span class="text-sky-700 dark:text-sky-300">{post.app_name}</span>
          <span aria-hidden="true">/</span>
          <time datetime={date}>{formattedDate}</time>
        </div>
        <h1 class="mt-5 text-4xl font-semibold leading-[1.08] tracking-[-0.04em] text-slate-950 dark:text-white sm:text-6xl">{title}</h1>
        <p class="mt-6 text-xl leading-8 text-slate-600 dark:text-slate-300">{excerpt}</p>
      </header>

      {image && (
        <div class:list={["mt-10 grid gap-3", images.length > 1 && "sm:grid-cols-2"]}>
          {images.map((url, index) => (
            <img
              src={url}
              alt={index === 0 ? title : `${post.app_name} — ${lang === "es" ? "imagen" : "image"} ${index + 1}`}
              class:list={[
                "w-full rounded-2xl border border-slate-200 object-cover dark:border-slate-800",
                index === 0 && images.length > 1 ? "aspect-[16/10] sm:row-span-2 sm:h-full" : "aspect-[16/9]",
              ]}
            />
          ))}
        </div>
      )}

      <div class="mt-10 space-y-6 text-[1.05rem] leading-8 text-slate-700 dark:text-slate-200">
        {content.split(/\n\s*\n/).filter(Boolean).map((paragraph) => <p>{paragraph}</p>)}
      </div>

      {post.tags && post.tags.length > 0 && (
        <ul class="mt-10 flex flex-wrap gap-2" aria-label={lang === "es" ? "Temas" : "Topics"}>
          {post.tags.map((tag) => <li class="rounded-full border border-slate-200 px-3 py-1 font-mono text-xs text-slate-600 dark:border-slate-800 dark:text-slate-300">#{tag}</li>)}
        </ul>
      )}

      {appUrl && (
        <aside class="mt-12 flex flex-col gap-5 rounded-2xl bg-slate-950 p-6 text-white sm:flex-row sm:items-center sm:justify-between sm:p-8">
          <div>
            <p class="font-mono text-xs uppercase tracking-[0.2em] text-sky-300">{post.app_name}</p>
            <h2 class="mt-2 text-xl font-semibold">{lang === "es" ? "Pruébala por ti mismo" : "Try it for yourself"}</h2>
          </div>
          <a class="inline-flex shrink-0 items-center justify-center rounded-full bg-white px-5 py-3 text-sm font-semibold text-slate-950 hover:bg-sky-100" href={appUrl} target="_blank" rel="noopener noreferrer">
            {lang === "es" ? "Abrir herramienta ↗" : "Open tool ↗"}
          </a>
        </aside>
      )}
    </article>
  )}
</BaseLayout>
