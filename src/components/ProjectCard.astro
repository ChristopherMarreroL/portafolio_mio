---
import Modal from "./ui/Modal.astro";
import { isEmbeddablePdfUrl, isPdfUrl } from "../lib/media";

type Lang = "es" | "en";
type I18nText = { es: string; en: string };

type Project = {
  title: I18nText;
  description: I18nText;
  tech?: string[];
  link?: string;
  github?: string;
  image?: string;
  gallery?: string[];
};

const { project, lang = "en" } = Astro.props as { project: Project; lang?: Lang };

const titleText = project.title?.[lang] ?? project.title.en;
const descText = project.description?.[lang] ?? project.description.en;

const modalId = `proj-${project.title.en.replace(/[^a-z0-9]+/gi, "-").toLowerCase()}`;
const previewItems = (project.gallery?.length ? project.gallery : project.image ? [project.image] : []);
const hasGallery = previewItems.length > 0;
const coverIsPdf = isPdfUrl(project.image);
const modalPreviewIsPdf = isPdfUrl(previewItems[0]);
const coverCanEmbedPdf = isEmbeddablePdfUrl(project.image);
const modalCanEmbedPdf = isEmbeddablePdfUrl(previewItems[0]);

const labels = {
  openProject: lang === "es" ? "Abrir proyecto" : "Open project",
  viewProject: lang === "es" ? "Ver proyecto" : "View project",
  viewGithub: lang === "es" ? "Ver GitHub" : "View GitHub",
  viewImages: lang === "es" ? "Ver imagenes" : "View images",
  viewImage: lang === "es" ? "Ver imagen" : "View image",
  projectPreviewAlt: lang === "es" ? "Vista del proyecto" : "Project preview",
  mainViewAlt: lang === "es" ? "Vista principal del proyecto" : "Main project view",
  thumbAlt: lang === "es" ? "Miniatura" : "Thumbnail",
  closeModal: lang === "es" ? "Cerrar dialogo" : "Close dialog",
};
---

<article
  class="group transform-gpu overflow-hidden rounded-xl border border-slate-200 bg-white
         shadow-[0_12px_36px_rgba(15,23,42,0.06)]
         transition-[transform,box-shadow,border-color,background-color] duration-500
         ease-[cubic-bezier(0.22,1,0.36,1)] will-change-transform
         hover:-translate-y-1.5 hover:scale-[1.02] hover:border-slate-300
         hover:shadow-[0_24px_70px_rgba(15,23,42,0.14)]
         motion-reduce:transform-none motion-reduce:transition-none
         dark:border-slate-800 dark:bg-slate-950 dark:shadow-black/20 dark:hover:shadow-[0_24px_70px_rgba(0,0,0,0.34)]"
>
  {project.image && (
    <div class="relative">
      {coverIsPdf ? (
        coverCanEmbedPdf ? (
          <iframe
            src={`${project.image}#page=1&view=FitH`}
            title={`${lang === "es" ? "PDF del proyecto" : "Project PDF"}: ${titleText}`}
            aria-hidden="true"
            class="pointer-events-none h-44 w-full bg-slate-100 dark:bg-slate-900"
            loading="lazy"
            tabindex="-1"
          ></iframe>
        ) : (
          <div class="flex h-44 w-full items-center justify-center bg-white dark:bg-slate-900"><span class="text-5xl font-black tracking-[-0.08em] text-red-600">PDF</span></div>
        )
      ) : (
        <img
          src={project.image}
          alt={`${labels.projectPreviewAlt} ${titleText}`}
          class="h-44 w-full object-cover transition-transform duration-700 ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:scale-[1.035] motion-reduce:transform-none motion-reduce:transition-none"
          loading="lazy"
        />
      )}

      <div
        class="pointer-events-none absolute inset-0
               bg-gradient-to-t from-black/55 via-black/10 to-transparent
               opacity-0 transition-opacity duration-[420ms] ease-[cubic-bezier(0.22,1,0.36,1)]
               group-hover:opacity-100 motion-reduce:transition-none"
      ></div>

      <div class="absolute right-3 top-3 flex gap-2">
        {project.link && (
          <a
            href={project.link}
            target="_blank"
            rel="noreferrer"
            title={labels.openProject}
            aria-label={labels.openProject}
            class="inline-flex h-10 w-10 items-center justify-center rounded-lg
                   bg-white/90 text-slate-900 backdrop-blur
                   opacity-0 translate-y-1
                   transition-all duration-200 ease-out
                   group-hover:opacity-100 group-hover:translate-y-0
                   focus-visible:opacity-100 focus-visible:translate-y-0
                   hover:scale-105 active:scale-95"
          >
            &#128279;
          </a>
        )}

        {hasGallery && (
          <>
            <button
              type="button"
              title={labels.viewImages}
              aria-label={labels.viewImages}
              class="inline-flex h-10 w-10 items-center justify-center rounded-lg
                     bg-white/90 text-slate-900 backdrop-blur
                     opacity-0 translate-y-1
                     transition-all duration-200 ease-out
                     group-hover:opacity-100 group-hover:translate-y-0
                     focus-visible:opacity-100 focus-visible:translate-y-0
                     hover:scale-105 active:scale-95
                     md:opacity-0 md:translate-y-1 md:group-hover:opacity-100 md:group-hover:translate-y-0
                     opacity-100 translate-y-0"
              onclick={`document.getElementById('${modalId}')?.showModal()`}
            >
              &#128065;
            </button>

            <Modal id={modalId} title={titleText} closeLabel={labels.closeModal}>
              <div class="space-y-4">
                <p class="mt-2 text-sm text-slate-500 dark:text-slate-400">
                  {descText}
                </p>

                {modalPreviewIsPdf ? (
                  <>
                    {modalCanEmbedPdf ? (
                      <iframe id={`${modalId}-main`} src={`${previewItems[0]}#view=FitH`} title={`${lang === "es" ? "PDF del proyecto" : "Project PDF"}: ${titleText}`} class="h-[70vh] w-full rounded-lg border border-slate-200 bg-slate-100 dark:border-slate-800 dark:bg-slate-900" loading="lazy"></iframe>
                    ) : (
                      <div class="flex min-h-72 flex-col items-center justify-center rounded-lg border border-slate-200 bg-slate-50 dark:border-slate-800 dark:bg-slate-900"><span class="text-6xl font-black tracking-[-0.08em] text-red-600">PDF</span><p class="mt-3 text-sm text-slate-500 dark:text-slate-400">{lang === "es" ? "Este documento externo se abre en una pestaña segura." : "This external document opens in a separate tab."}</p></div>
                    )}
                    <a href={previewItems[0]} target="_blank" rel="noopener noreferrer" class="inline-flex rounded-full bg-slate-950 px-4 py-2 text-sm font-semibold text-white dark:bg-white dark:text-slate-950">{lang === "es" ? "Abrir PDF completo ↗" : "Open full PDF ↗"}</a>
                  </>
                ) : (
                  <img id={`${modalId}-main`} src={previewItems[0]} alt={`${labels.mainViewAlt} ${titleText}`} class="w-full rounded-lg border border-slate-200 dark:border-slate-800" loading="lazy" />
                )}

                <div class="flex gap-2 overflow-x-auto pb-1">
                  {previewItems.length > 1 && previewItems.map((img: string, idx: number) => (
                    <button
                      type="button"
                      data-gallery-target={`${modalId}-main`}
                      data-gallery-src={img}
                      class={`shrink-0 rounded-lg border transition
                              ${idx === 0 ? "border-slate-900 dark:border-white" : "border-slate-200 dark:border-slate-800"}
                              hover:opacity-90`}
                      title={labels.viewImage}
                      aria-label={labels.viewImage}
                    >
                      <img
                        src={img}
                        alt={`${labels.thumbAlt} ${idx + 1} - ${titleText}`}
                        class="h-16 w-24 rounded-lg object-cover"
                        loading="lazy"
                      />
                    </button>
                  ))}
                </div>

                {project.link && (
                  <a
                    href={project.link}
                    target="_blank"
                    rel="noreferrer"
                    class="inline-flex items-center gap-2 text-sm font-medium underline underline-offset-4
                           text-slate-900 hover:opacity-80 dark:text-slate-100"
                  >
                    {labels.openProject} <span aria-hidden="true">&rarr;</span>
                  </a>
                )}
              </div>
            </Modal>
          </>
        )}

        {project.github && (
          <a
            href={project.github}
            target="_blank"
            rel="noreferrer"
            title={labels.viewGithub}
            aria-label={labels.viewGithub}
            class="inline-flex h-10 w-10 items-center justify-center rounded-lg
                   bg-white/90 text-slate-900 backdrop-blur
                   opacity-100 translate-y-0
                   transition-all duration-200 ease-out
                   md:opacity-0 md:translate-y-1 md:group-hover:opacity-100 md:group-hover:translate-y-0
                   hover:scale-105 active:scale-95"
          >
            GH
          </a>
        )}
      </div>
    </div>
  )}

  <div class="p-5">
    <h3 class="font-semibold tracking-tight">{titleText}</h3>

    <p class="mt-2 text-sm text-slate-600 dark:text-slate-300">
      {descText}
    </p>

    <div class="mt-3 flex flex-wrap gap-2">
      {project.tech?.map((t: string) => (
        <span
          class="rounded-full bg-slate-100 px-2 py-1 text-xs text-slate-700
                 transition-all duration-200 ease-out
                 hover:-translate-y-0.5 hover:bg-slate-200
                 dark:bg-slate-900 dark:text-slate-200 dark:border dark:border-slate-800
                 dark:hover:bg-slate-800"
        >
          {t}
        </span>
      ))}
    </div>

    {project.link && (
      <a
        href={project.link}
        target="_blank"
        rel="noreferrer"
        class="mt-4 inline-flex items-center gap-2 text-sm font-medium
               underline underline-offset-4
               text-slate-900 transition-opacity duration-200 ease-out
               hover:opacity-80 dark:text-slate-100"
      >
        {labels.viewProject} <span aria-hidden="true">&rarr;</span>
      </a>
    )}

    {project.github && (
      <a
        href={project.github}
        target="_blank"
        rel="noreferrer"
        class="mt-4 ml-4 inline-flex items-center gap-2 text-sm font-medium
               underline underline-offset-4
               text-slate-900 transition-opacity duration-200 ease-out
               hover:opacity-80 dark:text-slate-100"
      >
        GitHub <span aria-hidden="true">→</span>
      </a>
    )}
  </div>
</article>

<script>
  document.addEventListener("click", (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;

    const button = target.closest<HTMLButtonElement>("button[data-gallery-target][data-gallery-src]");
    const imageId = button?.dataset.galleryTarget;
    const imageSource = button?.dataset.gallerySrc;
    if (!imageId || !imageSource) return;

    const mainImage = document.getElementById(imageId);
    if (mainImage instanceof HTMLImageElement || mainImage instanceof HTMLIFrameElement) mainImage.src = imageSource;
  });
</script>
